{
  "name": "industrial-ess-ems",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node --max-old-space-size=4096 ./node_modules/vite/bin/vite.js build",
    "deploy:gh-pages": "npm run build && node -e \"require('fs').copyFileSync('dist/index.html','dist/404.html')\" && npx gh-pages -d dist",
    "preview": "vite preview",
    "check": "node --max-old-space-size=4096 ./node_modules/vue-tsc/bin/vue-tsc.js -b",
    "lint": "eslint . --ext .ts,.vue",
    "lint:fix": "eslint . --ext .ts,.vue --fix"
  },
  "dependencies": {
    "@vitejs/plugin-vue": "^5.0.3",
    "clsx": "^2.1.1",
    "echarts": "^5.5.1",
    "element-plus": "^2.14.3",
    "lucide-vue-next": "^0.511.0",
    "pinia": "^2.1.7",
    "tailwind-merge": "^3.3.0",
    "vue": "^3.4.15",
    "vue-router": "^4.2.5"
  },
  "devDependencies": {
    "@types/node": "^22.15.30",
    "@typescript-eslint/eslint-plugin": "^7.0.1",
    "@typescript-eslint/parser": "^7.0.1",
    "@vue/runtime-dom": "^3.4.15",
    "@vue/tsconfig": "^0.7.0",
    "autoprefixer": "^10.4.17",
    "eslint": "^8.56.0",
    "eslint-plugin-vue": "^9.20.1",
    "gh-pages": "^6.3.0",
    "postcss": "^8.4.35",
    "sass": "^1.77.8",
    "tailwindcss": "^3.4.1",
    "typescript": "~5.3.3",
    "unplugin-vue-dev-locator": "^1.0.0",
    "vite": "^5.0.12",
    "vue-tsc": "^1.8.27"
  }
}
